{
  "openapi": "3.1.0",
  "info": {
    "title": "Mayo ADPKD audit demonstration API",
    "description": "Nonclinical synthetic worker/audit demo. Requires bearer authentication for audit, chat, and logs. The MIC calculator is a separate standalone Python and browser application.",
    "version": "3.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Health status JSON (no clinical certification)"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Counts and status as JSON (not Prometheus text)"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate synthetic demo thresholds and create signed audit entry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          },
          "401": {
            "description": "Missing bearer token"
          },
          "403": {
            "description": "Invalid bearer token"
          },
          "503": {
            "description": "API_ACCESS_TOKEN is not configured"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response (no real model inference)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          },
          "401": {
            "description": "Missing bearer token"
          },
          "403": {
            "description": "Invalid bearer token"
          },
          "503": {
            "description": "API_ACCESS_TOKEN is not configured"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read HMAC audit trail (authenticated only)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "401": {
            "description": "Missing bearer token"
          },
          "403": {
            "description": "Invalid bearer token"
          },
          "503": {
            "description": "API_ACCESS_TOKEN is not configured"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
